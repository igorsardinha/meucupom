# Banco de Dados
# Local (SQLite via libsql, criado automaticamente):
DATABASE_URL=file:./data/meucupom.db
# Produção na Vercel (Neon / Postgres):
# DATABASE_URL=postgresql://usuario:senha@host/meucupom?sslmode=require

# Better Auth
# Gere um segredo seguro: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-forte-com-pelo-menos-32-caracteres
# Em produção, defina o domínio final (ex: https://meucupom.com.br). Deixe vazio em Preview na Vercel.
BETTER_AUTH_URL=http://localhost:3000

# Login Social: Google OAuth
# Redirect URI no Google Cloud Console: {SUA_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login Social: Apple (Sign in with Apple - requer Apple Developer Program)
# Redirect URI no Apple Developer Portal: {SUA_URL}/api/auth/callback/apple
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Opcional (apenas se usar app iOS nativo):
# APPLE_APP_BUNDLE_IDENTIFIER=

# Login Social: Instagram (Instagram API with Instagram Login)
# Redirect URI no Meta for Developers: {SUA_URL}/api/auth/callback/instagram
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# Botão de conta demo (habilitado automaticamente em desenvolvimento)
ENABLE_DEMO_LOGIN=true

# Mercado Pago (Pagamentos e Assinatura Pro - opcional em desenvolvimento)
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Opcionais (padrão R$ 19,90/mês sem necessidade de plano pré-criado):
# MP_PRO_PRICE_BRL=19.90
# MP_PRO_PLAN_ID=

# E-mail transacional via Resend (Redefinição de senha - sem chave, imprime o link no console em dev)
RESEND_API_KEY=
EMAIL_FROM=meucupom <noreply@meucupom.com.br>

# Vercel Blob (Upload de fotos de perfil em nuvem - sem token, salva WebP compacto otimizado)
BLOB_READ_WRITE_TOKEN=

# Upstash Redis (Rate limiting distribuído - sem chaves, usa fallback em memória local)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
